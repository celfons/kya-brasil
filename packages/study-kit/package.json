{
  "name": "@kya-brasil/study-kit",
  "version": "0.1.3",
  "description": "Experiment kit for the KYA Brasil case study: an independent developer integrates KYA from the docs alone. Creates a local workspace with a throwaway test PKI, grades four tasks (issue a mandate, policy quality, offline verifier, revocation) automatically, asks a short open questionnaire and writes one anonymous report file. Everything stays local: no telemetry, no network calls.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "kya-study": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celfons/kya-brasil.git",
    "directory": "packages/study-kit"
  },
  "homepage": "https://github.com/celfons/kya-brasil/tree/main/packages/study-kit#readme",
  "bugs": {
    "url": "https://github.com/celfons/kya-brasil/issues"
  },
  "author": "Marcel Oliveira",
  "keywords": [
    "kya",
    "know-your-agent",
    "case-study",
    "usability",
    "e-cnpj",
    "icp-brasil"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kya-brasil/agent-tools": "workspace:*",
    "@kya-brasil/core": "workspace:*",
    "@peculiar/asn1-schema": "^2.3.15",
    "@peculiar/asn1-x509": "^2.3.15",
    "@peculiar/x509": "^2.1.0",
    "node-forge": "1.4.1",
    "reflect-metadata": "^0.2.2",
    "viem": "^2.57.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "tsx": "4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
