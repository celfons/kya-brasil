{
  "name": "@kya-brasil/core",
  "version": "0.7.0",
  "description": "KYA Brasil as a library: verify and issue know-your-agent credentials for Brazilian companies without any hosted service. e-CNPJ (ICP-Brasil) CMS signature and chain validation, CRL revocation, CNPJ, agent key challenges (EVM, Ed25519 / Web Bot Auth, ERC-8004), mandate schema and evaluation (including payment instruments for card networks and acquirers), credential build, Ed25519 signing and verification. Pure functions: storage and network are yours.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celfons/kya-brasil.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/celfons/kya-brasil/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/celfons/kya-brasil/issues"
  },
  "author": "Marcel Oliveira",
  "keywords": [
    "kya",
    "know-your-agent",
    "agent-identity",
    "brazil",
    "cnpj",
    "e-cnpj",
    "icp-brasil",
    "pkcs7",
    "cms",
    "crl",
    "mandate",
    "payments",
    "visa",
    "mastercard",
    "acquirer",
    "web-bot-auth",
    "erc-8004"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@peculiar/asn1-schema": "^2.3.15",
    "@peculiar/asn1-x509": "^2.3.15",
    "@peculiar/x509": "^2.1.0",
    "asn1js": "^3.0.6",
    "pkijs": "^3.4.1",
    "reflect-metadata": "^0.2.2",
    "viem": "^2.57.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
